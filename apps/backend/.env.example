BETTER_AUTH_SECRET="[YOUR_GENERATED_SECRET]"
BETTER_AUTH_URL="[BACKED_API_URL]"
TMDB_ACCESS_TOKEN="[YOUR_ACCESS_TOKEN]"
TMDB_API_KEY="[YOUR_API_KEY]"
# Direct connection. Used by drizzle-kit for migrations (needs transactions).
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/dbname?sslmode=require"
# Pooled connection via PgBouncer. Used by the running app. Optional — falls
# back to DATABASE_URL if unset.
DATABASE_URL_POOLED="postgresql://user:password@ep-xxx-pooler.us-east-2.aws.neon.tech/dbname?sslmode=require"
PORT=3241